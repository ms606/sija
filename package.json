{
  "name": "finnish-noun-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "export:paradigms": "tsx tools/export-paradigms.ts",
    "verify:kotus": "tsx tools/kotus/verify-kotus.ts",
    "verify:morph": "npm run export:paradigms && tools/morph-oracle/.venv/bin/python tools/morph-oracle/check.py && tools/morph-oracle/.venv/bin/python tools/morph-oracle/sentences.py",
    "audit:grammar": "npm run audit:export && tools/morph-oracle/.venv/bin/python tools/audit/generate-report.py --run-audits",
    "audit:export": "tsx tools/audit/export-snapshot.ts",
    "audit:test": "npm run audit:export && tools/morph-oracle/.venv/bin/python -m unittest discover -s tools/audit/tests",
    "audit:explanations": "tsx tools/audit/explanation-audit.ts",
    "verify:all": "tools/morph-oracle/.venv/bin/python tools/audit/verify-all.py",
    "images:fetch": "tsx tools/images/fetch-commons.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  },
  "description": "Sija — an interactive Finnish noun grammar lab (cases, stems, consonant gradation, -i nouns, plurals)."
}
