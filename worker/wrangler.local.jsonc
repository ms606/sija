// Local development of the sync API: `npm run worker:dev`.
// The production config (../wrangler.jsonc) stays static-only until step 4 of
// the sync plan creates the D1 database, so redeploys keep working until then.
// Step 4 moves these settings into ../wrangler.jsonc with the real database id.
{
  "name": "sija",
  "main": "index.ts",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "../dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sija-sync",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
