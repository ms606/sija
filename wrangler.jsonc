// Cloudflare Workers deployment: serves the static build in dist/, no server code.
// Unknown paths (e.g. /cases/illative) get index.html so client-side routes work.
{
  "name": "sija",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application"
  }
}
