// Cloudflare Workers deployment: the static build in dist/ plus the sync API.
// Only /api/* runs the Worker (worker/index.ts); every other request is served
// straight from dist/, and unknown paths (e.g. /cases/illative) get index.html
// so client-side routes work.
//
// The D1 database is restricted to the EU jurisdiction. `wrangler dev` and the
// tests use a local copy of it, never this one.
{
  "name": "sija",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sija-sync",
      "database_id": "9f8148ec-0bfa-49eb-bdd0-df3f007d4018",
      "migrations_dir": "worker/migrations"
    }
  ]
}
